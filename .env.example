# Non-secret local settings only. Gmail OAuth files must stay outside this repository.
GOVSCOUT_CONFIG=config/default.toml
GOVSCOUT_DATABASE=var/govscout.sqlite3
GOVSCOUT_GOOGLE_CREDENTIALS=/absolute/path/outside/repo/google-client-secret.json
GOVSCOUT_GOOGLE_TOKEN=/absolute/path/outside/repo/google-token.json
GOVSCOUT_COMPANIES_HOUSE_API_KEY=<official-api-key>

# Public reverse-proxy deployment. Place populated values in a private mode-0600
# service environment file outside the repository; never store a plaintext password.
GOVSCOUT_DEPLOYMENT_MODE=public-proxy
GOVSCOUT_BIND_HOST=127.0.0.1
GOVSCOUT_PUBLIC_HOST=leads.misegroup.co.uk
GOVSCOUT_USERNAME=<single-operator-username>
GOVSCOUT_PASSWORD_HASH=<versioned-scrypt-hash>
GOVSCOUT_SESSION_SECRET=<base64url-encoded-random-secret-at-least-32-bytes>
